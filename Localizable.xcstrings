    "Les deux premiers raccourcis seront affichés sur l'écran d'accueil.\nRéalisez un appui prolongé sur un raccourci puis déplacez le pour le réordonner dans la liste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ersten beiden Kurzbefehle werden auf dem Startbildschirm angezeigt.\nHalten Sie einen Kurzbefehl gedrückt und ziehen Sie ihn, um die Reihenfolge in der Liste zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The first two shortcuts will be shown on the home screen.\nLong press a shortcut and drag it to reorder it in the list."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux premiers raccourcis seront affichés sur l'écran d'accueil.\nRéalisez un appui prolongé sur un raccourci puis déplacez le pour le réordonner dans la liste."
          }
        }
      }
    },
