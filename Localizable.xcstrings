    "Les raccourcis seront triés par pertinence temporelle. Les plus proches en termes d'horaire et de jour seront affichés en premier, sauf si vous êtes très proche de la destination." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kurzbefehle werden nach zeitlicher Relevanz sortiert. Die zeitlich und vom Tag her nächsten werden zuerst angezeigt, es sei denn, Sie sind sehr nah am Ziel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shortcuts are sorted by time relevance. Those closest in schedule and day appear first; unless you’re very close to your destination."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les raccourcis seront triés par pertinence temporelle. Les plus proches en termes d'horaire et de jour seront affichés en premier, sauf si vous êtes très proche de la destination."
          }
        }
      }
    },
