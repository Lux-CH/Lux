          "stringUnit" : {
            "state" : "translated",
            "value" : "By setting up a programmation, Lux will suggest the shortcut on the home screen based on the time of day.\nFor example, if you use a shortcut every day at 8 AM, Lux will highlight it around that time."
          }
        },
